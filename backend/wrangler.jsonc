// Configuración del backend del Agente ENE en Cloudflare Workers.
// Cada línea comentada explica qué pieza del agente activa.
{
  "$schema": "node_modules/wrangler/config-schema.json",

  // El nombre del Worker decide la URL pública: https://ia-toolkit.<subdominio-de-tu-cuenta>.workers.dev
  // Coincide con el "Project name" que Cloudflare propone al importar el fork (el nombre del repo). Si no
  // coinciden, el build falla. Es el mismo en todos los forks: cada cuenta tiene su propio subdominio.
  "name": "ia-toolkit",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  // Cada rama (por ejemplo, la de un pull request de Jules) recibe su propia URL de vista previa.
  "preview_urls": true,

  // Logs en el panel de Cloudflare (Workers → Logs). Sirven para leer qué hizo el agente.
  "observability": { "enabled": true },

  // Permite importar archivos .md como texto: así objetivo.md y las skills son archivos que se editan a mano.
  "rules": [{ "type": "Text", "globs": ["**/*.md"], "fallthrough": true }],

  // MEMORIA: la memoria del agente (qué boletín ya vio, borradores, nota publicada).
  // Es un Durable Object con SQLite (la clase Memoria de src/memoria-durable.ts). Cloudflare la crea sola
  // en el primer despliegue: no hay ningún id que copiar.
  "durable_objects": { "bindings": [{ "name": "MEMORIA", "class_name": "Memoria" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Memoria"] }],

  // AI: Workers AI. Se usa para convertir el PDF del INE a texto (toMarkdown). No cuesta nada para PDF.
  "ai": { "binding": "AI" },

  // VISTAS PREVIAS: cada rama que no es main (por ejemplo, el pull request de Jules) se publica aparte, con su
  // propia URL y su propia memoria vacía, sin tocar producción. Cloudflare exige repetir aquí lo que el agente
  // usa; si falta este bloque, el build de la vista previa falla. No hace falta editarlo.
  "previews": {
    "durable_objects": { "bindings": [{ "name": "MEMORIA", "class_name": "Memoria" }] },
    "ai": { "binding": "AI" },
    "vars": {
      "NOMBRE_EQUIPO": "Vista previa",
      "GEMINI_MODELOS": "gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest",
      "MAX_PASOS": "8",
      "MOTOR": "propio"
    }
  },

  // Variables no secretas. Las secretas (GEMINI_API_KEY, CLAVE_APROBACION) NO van aquí: se escriben en el
  // panel de Cloudflare (Settings → Runtime variables and secrets → Add variable → Secret).
  "vars": {
    // El nombre de tu equipo. Cámbialo aquí mismo en GitHub (lápiz → Commit changes) y el Worker se
    // vuelve a desplegar solo.
    "NOMBRE_EQUIPO": "Mi equipo",
    // Modelos de Gemini en orden de preferencia. El motor "propio" prueba el siguiente si uno no responde;
    // el motor "adk" usa solo el primero.
    "GEMINI_MODELOS": "gemini-3.6-flash,gemini-3.5-flash,gemini-flash-latest",
    // Cuántas veces puede el modelo pedir algo antes de que el programa corte la corrida.
    "MAX_PASOS": "8",
    // Qué motor corre el bucle: "propio" (src/agente/bucle.ts) o "adk" (Google ADK, src/agente/motor-adk.ts).
    "MOTOR": "propio"
  }

  // ── Clase 8: el disparador. Descomentar (y agregar una coma al final del bloque "vars") para que el agente
  //    corra solo todos los días a las 09:30 de Chile (12:30 UTC).
  // "triggers": { "crons": ["30 12 * * *"] },

  // ── Clase 8: el RAG propio vive en Neon; la cadena de conexión es el secreto DATABASE_URL (no va aquí).
  //    Se agrega en el panel de Cloudflare, igual que GEMINI_API_KEY. Ver docs/PASO_A_PASO_CLASE_8.md.
}
