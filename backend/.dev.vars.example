# Solo para probar en local (npx wrangler dev). Copiar este archivo como .dev.vars (sin .example) y completar.
# .dev.vars NUNCA se comparte ni se sube a ningún lado: son los secretos del equipo.
# En producción los secretos NO salen de aquí: se escriben en el panel de Cloudflare
# (Workers & Pages → ia-toolkit → Settings → Variables and Secrets → Add → tipo Secret).

# Clave de la API de Gemini (la entrega el profesor). Si falta, el agente corre en modo simulado.
GEMINI_API_KEY=

# Clave que se exige para aprobar o rechazar borradores desde el frontend. Inventen una frase.
CLAVE_APROBACION=cambiar-esta-clave

# Clase 8: la cadena de conexión de tu proyecto en Neon (postgresql://…?sslmode=require). Si falta, el agente
# busca por palabras en el corpus local en vez de buscar por significado.
DATABASE_URL=
